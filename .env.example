# Copy to .env — never commit real secrets
DATABASE_URL=postgresql://sg:CHANGE_ME@localhost:5432/sg
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_BUCKET=sg-private-documents
# PAYMENT_PROVIDER — not used in Model A (ADR-001)
# PAYMENT_WEBHOOK_SECRET=
WHATSAPP_BUSINESS_TOKEN=
AI_PROVIDER=anthropic
AI_API_KEY=
JWT_SECRET=                     # >= 32 chars, from a secret manager
OTP_PEPPER=                     # random secret
LOTTERY_SEED_KEY=               # 64 hex chars (openssl rand -hex 32); KMS in production
DEV_EXPOSE_OTP=false            # true only for local development; refused when NODE_ENV=production
PORT=3000
