# Copy to .env — never commit real secrets. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME      # used by docker-compose.yml (DATABASE_URL is derived from it there)
DATABASE_URL=postgresql://sg:CHANGE_ME@localhost:5432/sg
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_BUCKET=sg-private-documents
# PAYMENT_PROVIDER — not used in Model A (ADR-001)
# PAYMENT_WEBHOOK_SECRET=
WHATSAPP_BUSINESS_TOKEN=
AI_PROVIDERS=gemini,groq          # order = failover order; empty → deterministic template only (docs/AI_PROVIDERS.md)
GEMINI_API_KEY=                   # free key from Google AI Studio (aistudio.google.com/apikey). Free-tier prompts may be used by Google: the app sends only numeric circle facts and the question typed, never names, phones or IBANs from the database
AI_MODEL_GEMINI=                  # optional; default gemini-flash-latest
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
JWT_SECRET=                     # >= 32 chars, from a secret manager
OTP_PEPPER=                     # random secret
LOTTERY_SEED_KEY=               # 64 hex chars (openssl rand -hex 32); KMS in production
DEV_EXPOSE_OTP=false            # true only for local development; refused when NODE_ENV=production.
                                # No SMS provider is integrated, so in production sign-in is Google only (mobile code turns on only with this dev flag)
PORT=3000
WEB_DIST=                       # absolute path to apps/web/dist to serve the web app from the API
PAYOUT_ENCRYPTION_KEY=          # 64 hex chars; encrypts IBANs / wallet numbers at rest (KMS in production)
UPLOAD_DIR=                     # private directory for receipts and promissory notes (S3-compatible bucket in production)
GOOGLE_CLIENT_ID=               # OAuth "Web application" client id (Google Cloud Console → Credentials). Free. Add your site to Authorized JavaScript origins
GOOGLE_IOS_CLIENT_ID=           # optional: OAuth "iOS" client id for Google sign-in inside the iPhone/iPad app (docs/MOBILE_APPS.md)
PLATFORM_ADMIN_EMAILS=          # comma-separated Google emails bootstrapped as platform reviewers (Google-only mode)
PLATFORM_ADMIN_PHONES=          # comma-separated E.164 numbers bootstrapped as platform reviewers
REMINDERS_EVERY_MINUTES=60      # 0 = reminders only on demand
CORS_ORIGINS=https://localhost,capacitor://localhost   # origins of the Android / iOS apps (Capacitor)
TIER_LIMITS_EGP=                # small,medium,large maxima in EGP; empty keeps Egyptian circles disabled
TIER_LIMITS_AED=                # same for the UAE
